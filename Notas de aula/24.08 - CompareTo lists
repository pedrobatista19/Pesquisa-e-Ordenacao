=== CÓDIGO EM PYTHON ===

class Pessoa:
    def __init__(self, nome, idade):
        self.nome = nome
        self.idade = idade

    # 1 - Equivalente ao compareTo()
    def __lt__(self, outra_pessoa):
        return self.nome < outra_pessoa.nome

    # Equivalente ao toString()
    def __repr__(self):
        return f"Pessoa(nome='{self.nome}', idade={self.idade})"

lista = []

lista.append(Pessoa("Gabriel", 19))
lista.append(Pessoa("Alex", 52))
lista.append(Pessoa("Gabriel", 20))

# Ordena por ordem alfabética dos nomes
lista.sort()
print(lista)

# 2 - Custom sort usando lambda 
lista.sort(key=lambda p: p.idade, reverse=True)
print(lista[0])

